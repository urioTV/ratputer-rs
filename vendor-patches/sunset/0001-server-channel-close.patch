+    /// RATPUTER PATCH: end a channel from this side.
+    ///
+    /// Upstream only answers a peer's EOF/CLOSE, so a server could not end
+    /// an `exec` command or a shell `exit`. Sends `exit-status` (session
+    /// channels, when given), then EOF and CLOSE. The peer's CLOSE reply is
+    /// handled as usual; the application still calls `channel_done()`.
+    pub(crate) fn finish(
+        &mut self,
+        num: ChanNum,
+        exit_status: Option<u32>,
+        s: &mut TrafSend,
+    ) -> Result<()> {
+        let ch = self.get_mut(num)?;
+        if ch.sent_close {
+            return Ok(());
+        }
+        if let (Some(status), ChanType::Session) = (exit_status, &ch.ty) {
+            Req::ExitStatus(status).send(ch, s)?;
+        }
+        if !ch.sent_eof {
+            s.send(packets::ChannelEof { num: ch.send_num()? })?;
+            ch.sent_eof = true;
+        }
+        s.send(packets::ChannelClose { num: ch.send_num()? })?;
+        ch.sent_close = true;
+        Ok(())
+    }
