+/// Opaque position for resuming an append without walking the FAT chain again.
+///
+/// Obtain this from [`FileWriter::append_cursor`] immediately before finishing
+/// a writer, then pass it to [`FileWriter::new_append_from_cursor`] after the
+/// directory entry has been reopened. The constructor revalidates the file
+/// identity and committed length before trusting the cached cluster position.
+///
+/// RATPUTER PATCH: FTP writes arrive in independently-polled chunks and cannot
+/// retain a borrowing `FileWriter` between polls. A cursor keeps those chunks
+/// linear-time without exposing FAT cluster internals to the caller.
+#[cfg(feature = "write")]
+#[derive(Clone, Copy, Debug)]
+pub struct AppendCursor {
+    first_cluster: Option<Cluster<usize>>,
+    current_cluster: Option<Cluster<usize>>,
+    offset_in_cluster: usize,
+    total_written: usize,
+    entry_parent: Cluster<usize>,
+    entry_offset: usize,
+    entry_short_name: ShortFileName,
+    entry_created: crate::time::FatDateTime,
+}
