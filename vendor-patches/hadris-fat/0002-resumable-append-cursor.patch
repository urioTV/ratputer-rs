+    /// Resume appending from a cursor returned by [`Self::append_cursor`].
+    ///
+    /// Unlike [`Self::new_append`], this performs only constant-time
+    /// validation and does not walk from the file's first cluster to its tail.
+    /// The cursor is rejected if the directory slot, identity, first cluster,
+    /// committed size, cluster offset, or chain tail no longer match.
+    pub async fn new_append_from_cursor(
+        fs: &'a FatVolume<DATA>,
+        entry: &FileEntry,
+        cursor: AppendCursor,
+    ) -> Result<Self> {
+        if entry.is_directory() {
+            return Err(Error::NotAFile);
+        }
+
+        let first_cluster = if entry.cluster().0 >= 2 {
+            Some(entry.cluster())
+        } else {
+            None
+        };
+        if entry.parent_clus != cursor.entry_parent
+            || entry.offset_within_cluster != cursor.entry_offset
+            || entry.short_name != cursor.entry_short_name
+            || entry.created != cursor.entry_created
+            || first_cluster != cursor.first_cluster
+            || entry.len() as usize != cursor.total_written
+            || cursor.offset_in_cluster > fs.info.cluster_size
+            || (cursor.total_written > 0 && cursor.current_cluster.is_none())
+        {
+            return Err(Error::StaleEntry);
+        }
+
+        if let Some(current) = cursor.current_cluster {
+            if fs.next_cluster_routed(current.0).await?.is_some() {
+                return Err(Error::StaleEntry);
+            }
+        }
+
+        let fixed_root = if entry.parent_clus.0 == 0 {
+            fs.fixed_root_dir_info()
+        } else {
+            None
+        };
+        fs.register_writer(entry.parent_clus, entry.offset_within_cluster)?;
+
+        Ok(Self {
+            fs,
+            first_cluster: cursor.first_cluster,
+            current_cluster: cursor.current_cluster,
+            offset_in_cluster: cursor.offset_in_cluster,
+            total_written: cursor.total_written,
+            first_allocated_cluster: None,
+            allocation_predecessor: None,
+            allocation_start_offset: 0,
+            allocation_start_total_written: 0,
+            entry_parent: cursor.entry_parent,
+            entry_offset: cursor.entry_offset,
+            entry_short_name: cursor.entry_short_name,
+            entry_created: cursor.entry_created,
+            fixed_root,
+            pending_modified: None,
+            pending_accessed: None,
+            pending_created: None,
+            finished: false,
+        })
+    }
