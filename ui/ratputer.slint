// ratputer.slint — RATPUTER for M5Stack Cardputer ADV (240×135 px), no_std.
// Press Start 2P contains basic ASCII only, so every UI label stays ASCII.

import "fonts/PressStart2P-Regular.ttf";

// One list row. Instantiated statically: `for` repeater rows are separate heap
// components (~2 KiB each here), which starved FTP of memory.
component ListRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <length> indent: 2px;
    background: selected ? #0e2b17 : transparent;
    Text {
        text: (root.selected ? "> " : "  ") + root.label;
        x: root.indent;
        color: root.selected ? #7dffa9 : #4a7a5a;
        font-size: 8px;
        vertical-alignment: center;
        overflow: clip;
    }
}

export component MainWindow inherits Window {
    default-font-family: "Press Start 2P";

    in property <bool> splash-done: false;
    in-out property <int> frame-index: 0;

    // 0 menu, 1 rat, 2 Wi-Fi menu, 3 saved, 4 scan, 5 password,
    // 6 about, 7 USB disk, 8 FTP server, 9 FTP password edit,
    // 10 SD browser, 11 actions, 12 name input, 13 delete confirmation.
    in-out property <int> view-state: 0;
    in-out property <int> menu-index: 0;
    in-out property <int> wifi-menu-index: 0;
    in-out property <int> saved-index: 0;
    in-out property <int> scan-index: 0;

    in property <[string]> saved-networks;
    in property <[string]> scan-networks;
    in-out property <string> wifi-status: "SD: CHECKING";
    in-out property <string> wifi-selected-ssid: "";
    in-out property <string> wifi-password: "";

    // Firmware polls and clears this command: 1 scan, 2 connect saved,
    // 3 select scan result, 4 connect with password, 5 forget saved.
    in-out property <int> wifi-action: 0;
    in-out property <int> wifi-action-index: 0;
    // Spinner popup shown over the current view while the radio is busy.
    in-out property <bool> wifi-connecting: false;

    // Firmware polls and clears this command: 1 attach/export SD, 2 detach.
    in-out property <int> usb-disk-action: 0;
    in property <string> usb-disk-status: "USB NOT ACTIVE";
    in property <string> usb-disk-stats: "";

    // SSH+SFTP server: firmware polls and clears this command.
    // 1 start (screen opened), 2 stop (leaving), 3 open password editor,
    // 4 save password, 5 cancel password edit.
    in-out property <int> ssh-action: 0;
    in property <string> ssh-status: "OFF";
    in property <string> ssh-addr: "NO WI-FI";
    in property <string> ssh-user: "USER:RAT";
    in property <string> ssh-stats: "";
    in property <string> ssh-key-top: "";
    in property <string> ssh-key-bottom: "";
    in-out property <string> ssh-password: "";

    // SD browser state is driven by Rust; the Slint callback only opens it.
    // Visible browser rows (Rust windows the page into these six slots).
    in property <int> fm-count: 0;
    in property <string> fm-row-0;
    in property <string> fm-row-1;
    in property <string> fm-row-2;
    in property <string> fm-row-3;
    in property <string> fm-row-4;
    in property <string> fm-row-5;
    in property <string> fm-path: "/";
    in property <string> fm-status: "";
    in property <string> fm-clipboard: "";
    in property <string> fm-name: "";
    in property <string> fm-target: "";
    in property <string> fm-prompt: "";
    in property <bool> fm-more: false;
    in property <int> fm-page: 1;
    // Selected row within the visible window, not within the page.
    in property <int> fm-index: 0;
    in property <int> fm-action-index: 0;

    // Top bar (main screen only): clock, Wi-Fi link, battery.
    in property <string> clock-text: "--:--";
    in property <bool> clock-synced: false;
    // 0 offline, 1 connecting, 2 connected (no IP yet), 3 online (DHCP lease).
    in property <int> link-state: 0;
    in property <string> link-ssid: "";
    // -1 = no reading yet.
    in property <int> battery-percent: -1;

    property <[string]> menu-labels: ["RAT VIEW", "WI-FI", "USB DISK", "SSH + SFTP SERVER", "SD FILES", "ABOUT"];
    property <[string]> wifi-menu-labels: ["SAVED NETWORKS", "SCAN NETWORKS"];
    property <[string]> statuses: ["STALKING", "SNIFFING", "HUNTING", "LOITERING"];
    property <string> dots: frame-index == 0 ? " |" : frame-index == 1 ? " /" : frame-index == 2 ? " -" : " +";

    // Native 32x20 pixel art; both Image elements render it at 128x80 with
    // pixelated nearest-neighbor scaling. Do not pre-upscale the PNG files:
    // software-renderer embedding would quadruple each dimension in flash.
    property <[image]> frames: [
        @image-url("images/rat0.png"),
        @image-url("images/rat1.png"),
        @image-url("images/rat2.png"),
        @image-url("images/rat3.png"),
    ];

    callback key-pressed(string);
    key-pressed(key) => {
        if (key == "back") {
            if (root.view-state == 5) {
                root.wifi-password = "";
                root.view-state = 4;
            } else if (root.view-state == 3 || root.view-state == 4) {
                root.view-state = 2;
            } else if (root.view-state == 7) {
                root.usb-disk-action = 2;
            } else if (root.view-state == 8) {
                root.ssh-action = 2;
                root.view-state = 0;
            } else if (root.view-state == 9) {
                root.ssh-action = 5;
            } else if (root.view-state != 0) {
                root.view-state = 0;
            }
        } else if (key == "backspace") {
            // Password editing itself is handled in Rust.
        } else if (key == "delete" && root.view-state == 3 && root.saved-networks.length > 0) {
            root.wifi-action-index = root.saved-index;
            root.wifi-action = 5;
        } else if (key == "enter" || key == "space") {
            if (root.view-state == 0) {
                if (root.menu-index == 2) {
                    root.usb-disk-action = 1;
                    root.view-state = 7;
                } else if (root.menu-index == 3) {
                    root.ssh-action = 1;
                    root.view-state = 8;
                } else {
                    root.view-state = root.menu-index == 0 ? 1 : root.menu-index == 1 ? 2 : root.menu-index == 4 ? 10 : 6;
                }
            } else if (root.view-state == 1 || root.view-state == 6) {
                root.view-state = 0;
            } else if (root.view-state == 7) {
                root.usb-disk-action = 2;
            } else if (root.view-state == 8) {
                root.ssh-action = 2;
                root.view-state = 0;
            } else if (root.view-state == 9) {
                root.ssh-action = 4;
            } else if (root.view-state == 2) {
                if (root.wifi-menu-index == 0) {
                    root.view-state = 3;
                } else {
                    root.wifi-status = "SCANNING... 2 PASSES";
                    root.wifi-connecting = true;
                    root.wifi-action = 1;
                    root.view-state = 4;
                }
            } else if (root.view-state == 3 && root.saved-networks.length > 0) {
                root.wifi-action-index = root.saved-index;
                root.wifi-connecting = true;
                root.wifi-action = 2;
            } else if (root.view-state == 4 && root.scan-networks.length > 0) {
                root.wifi-action-index = root.scan-index;
                root.wifi-action = 3;
            } else if (root.view-state == 5) {
                root.wifi-connecting = true;
                root.wifi-action = 4;
            }
        } else if (key == "tab" && root.view-state == 8) {
            root.ssh-action = 3;
            root.view-state = 9;
        } else if (key == "tab" || key == "down" || key == "right") {
            if (root.view-state == 0) {
                root.menu-index = Math.mod(root.menu-index + 1, root.menu-labels.length);
            } else if (root.view-state == 2) {
                root.wifi-menu-index = Math.mod(root.wifi-menu-index + 1, root.wifi-menu-labels.length);
            } else if (root.view-state == 3 && root.saved-networks.length > 0) {
                root.saved-index = Math.mod(root.saved-index + 1, root.saved-networks.length);
            } else if (root.view-state == 4 && root.scan-networks.length > 0) {
                root.scan-index = Math.mod(root.scan-index + 1, root.scan-networks.length);
            }
        } else if (key == "up" || key == "left") {
            if (root.view-state == 0) {
                root.menu-index = Math.mod(root.menu-index + root.menu-labels.length - 1, root.menu-labels.length);
            } else if (root.view-state == 2) {
                root.wifi-menu-index = Math.mod(root.wifi-menu-index + root.wifi-menu-labels.length - 1, root.wifi-menu-labels.length);
            } else if (root.view-state == 3 && root.saved-networks.length > 0) {
                root.saved-index = Math.mod(root.saved-index + root.saved-networks.length - 1, root.saved-networks.length);
            } else if (root.view-state == 4 && root.scan-networks.length > 0) {
                root.scan-index = Math.mod(root.scan-index + root.scan-networks.length - 1, root.scan-networks.length);
            }
        }
    }

    splash := Rectangle {
        opacity: 1;
        background: @linear-gradient(180deg, #05130b 0%, #020503 100%);
        VerticalLayout {
            padding: 3px;
            spacing: 2px;
            Rectangle {
                height: 17px;
                background: #0d2b16;
                border-radius: 2px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text { text: "RATPUTER"; color: #7dffa9; font-size: 12px; vertical-alignment: center; }
                    Text { text: "BOOT"; color: #3d8a5a; font-size: 8px; vertical-alignment: center; horizontal-alignment: right; }
                }
            }
            Rectangle {
                background: #030903;
                border-radius: 3px;
                border-width: 1px;
                border-color: #143a20;
                Image {
                    source: frames[frame-index];
                    x: (parent.width - 128px) / 2;
                    y: (parent.height - 80px) / 2;
                    width: 128px;
                    height: 80px;
                    image-rendering: pixelated;
                }
            }
            HorizontalLayout {
                height: 12px;
                padding-left: 3px;
                padding-right: 3px;
                Text { text: statuses[frame-index] + dots; color: #46a06a; font-size: 8px; vertical-alignment: center; }
                Text { text: "240x135"; color: #2b5c3b; font-size: 8px; vertical-alignment: center; horizontal-alignment: right; }
            }
        }
    }

    mainscreen := Rectangle {
        opacity: 0;
        background: @linear-gradient(180deg, #030a06 0%, #010402 100%);

        top-bar := Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: 11px;
            background: #0a1f10;

            Text {
                x: 3px; y: 0;
                width: 40px; height: 11px;
                text: root.clock-text;
                color: root.clock-synced ? #7dffa9 : #2b5c3b;
                font-size: 8px;
                vertical-alignment: center;
            }

            // Signal bars: lit when online, dim when associated without an IP,
            // sweeping while connecting, dark when offline.
            for bar[i] in [2, 4, 6, 8] : Rectangle {
                x: 50px + i * 3px;
                y: 9px - bar * 1px;
                width: 2px;
                height: bar * 1px;
                background: root.link-state == 3 ? #7dffa9
                    : root.link-state == 2 ? #46a06a
                    : root.link-state == 1 && i <= root.frame-index ? #46a06a
                    : #143a20;
            }
            Text {
                x: 65px; y: 0;
                width: 120px; height: 11px;
                text: root.link-state >= 2 ? root.link-ssid : root.link-state == 1 ? "CONNECTING" : "OFFLINE";
                color: root.link-state == 3 ? #7dffa9 : #3d8a5a;
                font-size: 8px;
                vertical-alignment: center;
                overflow: clip;
            }

            Text {
                x: parent.width - 52px; y: 0;
                width: 32px; height: 11px;
                text: root.battery-percent < 0 ? "--%" : root.battery-percent + "%";
                color: root.battery-percent >= 0 && root.battery-percent < 15 ? #ff6b5a : #46a06a;
                font-size: 8px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            // Battery outline + nib + proportional fill.
            Rectangle {
                x: parent.width - 16px; y: 2px;
                width: 12px; height: 7px;
                border-width: 1px;
                border-color: #46a06a;
                Rectangle {
                    x: 2px; y: 2px;
                    width: root.battery-percent <= 0 ? 0px : Math.max(1px, 8px * root.battery-percent / 100);
                    height: 3px;
                    background: root.battery-percent >= 0 && root.battery-percent < 15 ? #ff6b5a : #7dffa9;
                }
            }
            Rectangle {
                x: parent.width - 4px; y: 4px;
                width: 1px; height: 3px;
                background: #46a06a;
            }
        }
        Rectangle {
            x: 0; y: 11px;
            width: parent.width;
            height: 1px;
            background: #143a20;
        }

        content := Rectangle {
            x: 0; y: 12px;
            width: parent.width;
            height: parent.height - 12px;

            menu := Rectangle {
                visible: view-state == 0;
                VerticalLayout {
                    padding: 5px;
                    spacing: 4px;
                    Text { text: "RATPUTER"; color: #7dffa9; font-size: 12px; horizontal-alignment: center; height: 18px; vertical-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    for item[i] in menu-labels : Rectangle {
                        border-radius: 2px;
                        background: menu-index == i ? #0e2b17 : transparent;
                        Text {
                            text: (menu-index == i ? "> " : "  ") + item;
                            x: 6px;
                            color: menu-index == i ? #7dffa9 : #4a7a5a;
                            font-size: 8px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text { text: "^v SELECT  ENTER OPEN"; color: #39684a; font-size: 8px; horizontal-alignment: center; }
                }
            }

            ratview := Rectangle {
                visible: view-state == 1;
                background: @linear-gradient(180deg, #05130b 0%, #020503 100%);
                VerticalLayout {
                    padding: 3px;
                    spacing: 2px;
                    Rectangle {
                        height: 17px;
                        background: #0d2b16;
                        border-radius: 2px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text { text: "RAT"; color: #7dffa9; font-size: 12px; vertical-alignment: center; }
                            Text { text: "PX x4"; color: #3d8a5a; font-size: 8px; vertical-alignment: center; horizontal-alignment: right; }
                        }
                    }
                    Rectangle {
                        background: #030903;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: #143a20;
                        Image {
                            source: frames[frame-index];
                            x: (parent.width - 128px) / 2;
                            y: (parent.height - 80px) / 2;
                            width: 128px;
                            height: 80px;
                            image-rendering: pixelated;
                        }
                    }
                    Text { text: "ENTER/BS = MENU"; color: #46a06a; font-size: 8px; horizontal-alignment: center; height: 12px; }
                }
            }

            wifi-menu := Rectangle {
                visible: view-state == 2;
                VerticalLayout {
                    padding: 5px;
                    spacing: 4px;
                    Text { text: "WI-FI"; color: #7dffa9; font-size: 12px; horizontal-alignment: center; height: 18px; vertical-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    for item[i] in wifi-menu-labels : Rectangle {
                        border-radius: 2px;
                        background: wifi-menu-index == i ? #0e2b17 : transparent;
                        Text {
                            text: (wifi-menu-index == i ? "> " : "  ") + item;
                            x: 6px;
                            color: wifi-menu-index == i ? #7dffa9 : #4a7a5a;
                            font-size: 8px;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: wifi-status; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text { text: "BS MENU  ENTER OPEN"; color: #39684a; font-size: 8px; horizontal-alignment: center; }
                }
            }

            saved-view := Rectangle {
                visible: view-state == 3;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    Text { text: "SAVED NETWORKS"; color: #7dffa9; font-size: 8px; horizontal-alignment: center; height: 14px; vertical-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    // Clipped viewport: the row column slides up so the selection stays visible.
                    saved-list := Rectangle {
                        clip: true;
                        property <int> rows: Math.max(1, Math.floor(self.height / 10px));
                        property <int> first: Math.max(0, root.saved-index - self.rows + 1);
                        if saved-networks.length == 0 : Text {
                            text: "NO SAVED NETWORKS";
                            color: #4a7a5a;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            x: 0;
                            y: -saved-list.first * 10px;
                            width: parent.width;
                            height: saved-networks.length * 10px;
                            alignment: start;
                            for item[i] in saved-networks : Rectangle {
                                height: 10px;
                                // Hide the partially visible row at the viewport edge.
                                visible: i >= saved-list.first && i < saved-list.first + saved-list.rows;
                                background: saved-index == i ? #0e2b17 : transparent;
                                Text {
                                    text: (saved-index == i ? "> " : "  ") + item;
                                    x: 3px;
                                    color: saved-index == i ? #7dffa9 : #4a7a5a;
                                    font-size: 8px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text { text: wifi-status; color: #46a06a; font-size: 8px; horizontal-alignment: center; height: 11px; }
                    Text { text: "ENTER CONNECT  DEL FORGET"; color: #39684a; font-size: 8px; horizontal-alignment: center; height: 11px; }
                }
            }

            scan-view := Rectangle {
                visible: view-state == 4;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    Text { text: "SCAN RESULTS"; color: #7dffa9; font-size: 8px; horizontal-alignment: center; height: 14px; vertical-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    // Clipped viewport: the row column slides up so the selection stays visible.
                    scan-list := Rectangle {
                        clip: true;
                        property <int> rows: Math.max(1, Math.floor(self.height / 10px));
                        property <int> first: Math.max(0, root.scan-index - self.rows + 1);
                        if scan-networks.length == 0 : Text {
                            text: "NO NETWORKS";
                            color: #4a7a5a;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            x: 0;
                            y: -scan-list.first * 10px;
                            width: parent.width;
                            height: scan-networks.length * 10px;
                            alignment: start;
                            for item[i] in scan-networks : Rectangle {
                                height: 10px;
                                // Hide the partially visible row at the viewport edge.
                                visible: i >= scan-list.first && i < scan-list.first + scan-list.rows;
                                background: scan-index == i ? #0e2b17 : transparent;
                                Text {
                                    text: (scan-index == i ? "> " : "  ") + item;
                                    x: 3px;
                                    color: scan-index == i ? #7dffa9 : #4a7a5a;
                                    font-size: 8px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text { text: wifi-status; color: #46a06a; font-size: 8px; horizontal-alignment: center; height: 11px; }
                    Text { text: "ENTER SELECT  BS BACK"; color: #39684a; font-size: 8px; horizontal-alignment: center; height: 11px; }
                }
            }

            password-view := Rectangle {
                visible: view-state == 5;
                VerticalLayout {
                    padding: 6px;
                    spacing: 5px;
                    Text { text: "WI-FI PASSWORD"; color: #7dffa9; font-size: 8px; horizontal-alignment: center; height: 14px; }
                    Text { text: wifi-selected-ssid; color: #46a06a; font-size: 8px; horizontal-alignment: center; height: 15px; }
                    Rectangle {
                        height: 24px;
                        border-width: 1px;
                        border-color: #2b5c3b;
                        background: #030903;
                        Text {
                            text: wifi-password + "_";
                            x: 4px;
                            width: parent.width - 8px;
                            color: #7dffa9;
                            font-size: 8px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Text { text: wifi-status; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text { text: "TYPE  ENTER CONNECT  ESC BACK"; color: #39684a; font-size: 8px; horizontal-alignment: center; }
                }
            }

            usb-disk-view := Rectangle {
                visible: view-state == 7;
                VerticalLayout {
                    padding: 6px;
                    spacing: 5px;
                    Text { text: "USB DISK"; color: #7dffa9; font-size: 12px; horizontal-alignment: center; height: 18px; vertical-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text { text: "SD IS EXCLUSIVE TO USB"; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Rectangle {
                        height: 24px;
                        border-width: 1px;
                        border-color: #2b5c3b;
                        background: #030903;
                        Text {
                            text: root.usb-disk-status;
                            color: #7dffa9;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: root.usb-disk-stats; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Text { text: "EJECT ON PC BEFORE EXIT"; color: #ffb347; font-size: 8px; horizontal-alignment: center; }
                    Text { text: "ENTER/BS = EXIT"; color: #39684a; font-size: 8px; horizontal-alignment: center; height: 12px; }
                }
            }

            ssh-view := Rectangle {
                visible: view-state == 8;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    Text { text: "SSH + SFTP SERVER"; color: #7dffa9; font-size: 12px; horizontal-alignment: center; height: 18px; vertical-alignment: center; }
                    Text { text: root.ssh-addr; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Text { text: root.ssh-user; color: #3d8a5a; font-size: 8px; horizontal-alignment: center; }
                    Rectangle {
                        height: 24px;
                        border-width: 1px;
                        border-color: #2b5c3b;
                        background: #030903;
                        Text {
                            text: root.ssh-status;
                            color: #7dffa9;
                            font-size: 8px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: root.ssh-key-top; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Text { text: root.ssh-key-bottom; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Text { text: root.ssh-stats; color: #3d8a5a; font-size: 8px; horizontal-alignment: center; }
                    Text { text: "TAB=PASS  ENTER/BS=STOP"; color: #39684a; font-size: 8px; horizontal-alignment: center; height: 12px; }
                }
            }

            ssh-password-view := Rectangle {
                visible: view-state == 9;
                VerticalLayout {
                    padding: 6px;
                    spacing: 5px;
                    Text { text: "SSH PASSWORD"; color: #7dffa9; font-size: 8px; horizontal-alignment: center; height: 14px; }
                    Text { text: "SERVER IS STOPPED WHILE EDITING"; color: #ffb347; font-size: 8px; horizontal-alignment: center; height: 15px; }
                    Rectangle {
                        height: 24px;
                        border-width: 1px;
                        border-color: #2b5c3b;
                        background: #030903;
                        Text {
                            text: ssh-password + "_";
                            x: 4px;
                            width: parent.width - 8px;
                            color: #7dffa9;
                            font-size: 8px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Text { text: root.ssh-status; color: #46a06a; font-size: 8px; horizontal-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text { text: "TYPE  ENTER SAVE  ESC CANCEL"; color: #39684a; font-size: 8px; horizontal-alignment: center; }
                }
            }

            fm-browser := Rectangle {
                visible: view-state == 10;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    Text { text: "SD " + root.fm-path; color: #7dffa9; font-size: 8px; height: 12px; overflow: clip; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    // Rust hands over only the rows that fit this viewport.
                    Rectangle {
                        clip: true;
                        if root.fm-count == 0 : Text { text: "EMPTY DIRECTORY"; color: #4a7a5a; font-size: 8px; vertical-alignment: center; horizontal-alignment: center; }
                        VerticalLayout {
                            alignment: start;
                            ListRow { height: 10px; visible: root.fm-count > 0; label: root.fm-row-0; selected: root.fm-index == 0; }
                            ListRow { height: 10px; visible: root.fm-count > 1; label: root.fm-row-1; selected: root.fm-index == 1; }
                            ListRow { height: 10px; visible: root.fm-count > 2; label: root.fm-row-2; selected: root.fm-index == 2; }
                            ListRow { height: 10px; visible: root.fm-count > 3; label: root.fm-row-3; selected: root.fm-index == 3; }
                            ListRow { height: 10px; visible: root.fm-count > 4; label: root.fm-row-4; selected: root.fm-index == 4; }
                            ListRow { height: 10px; visible: root.fm-count > 5; label: root.fm-row-5; selected: root.fm-index == 5; }
                        }
                    }
                    Text { text: root.fm-status; color: #ffb347; font-size: 8px; height: 11px; overflow: clip; }
                    Text { text: root.fm-clipboard; color: #46a06a; font-size: 8px; height: 11px; overflow: clip; }
                    Text { text: "<> PAGE " + fm-page + (fm-more ? "+" : "") + "  TAB ACTIONS"; color: #39684a; font-size: 8px; height: 11px; }
                }
            }

            fm-actions := Rectangle {
                visible: view-state == 11;
                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;
                    Text { text: "FILE ACTIONS"; color: #7dffa9; font-size: 8px; height: 13px; horizontal-alignment: center; }
                    Text { text: root.fm-path; color: #46a06a; font-size: 8px; height: 11px; overflow: clip; }
                    ListRow { height: 11px; indent: 5px; label: "COPY"; selected: root.fm-action-index == 0; }
                    ListRow { height: 11px; indent: 5px; label: "MOVE"; selected: root.fm-action-index == 1; }
                    ListRow { height: 11px; indent: 5px; label: "PASTE"; selected: root.fm-action-index == 2; }
                    ListRow { height: 11px; indent: 5px; label: "RENAME"; selected: root.fm-action-index == 3; }
                    ListRow { height: 11px; indent: 5px; label: "NEW FILE"; selected: root.fm-action-index == 4; }
                    ListRow { height: 11px; indent: 5px; label: "NEW DIR"; selected: root.fm-action-index == 5; }
                    ListRow { height: 11px; indent: 5px; label: "DELETE"; selected: root.fm-action-index == 6; }
                    Text { text: "ENTER SELECT  BS BACK"; color: #39684a; font-size: 8px; height: 11px; }
                }
            }

            fm-input := Rectangle {
                visible: view-state == 12;
                VerticalLayout {
                    padding: 6px;
                    spacing: 5px;
                    Text { text: root.fm-prompt; color: #7dffa9; font-size: 8px; height: 15px; horizontal-alignment: center; }
                    Text { text: root.fm-path; color: #46a06a; font-size: 8px; height: 13px; overflow: clip; }
                    Rectangle {
                        height: 24px;
                        border-width: 1px; border-color: #2b5c3b; background: #030903;
                        Text { text: root.fm-name + "_"; x: 4px; width: parent.width - 8px; color: #7dffa9; font-size: 8px; vertical-alignment: center; overflow: clip; }
                    }
                    Text { text: root.fm-status; color: #ffb347; font-size: 8px; overflow: clip; }
                    Text { text: "ENTER SAVE  ESC CANCEL"; color: #39684a; font-size: 8px; }
                }
            }

            fm-confirm := Rectangle {
                visible: view-state == 13;
                VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Text { text: "DELETE FILE / EMPTY DIR?"; color: #ffb347; font-size: 8px; height: 20px; horizontal-alignment: center; }
                    Text { text: root.fm-target; color: #7dffa9; font-size: 8px; height: 20px; horizontal-alignment: center; overflow: clip; }
                    Text { text: "PERMANENT - NO UNDO"; color: #ff6b5a; font-size: 8px; height: 18px; horizontal-alignment: center; }
                    Text { text: "ENTER DELETE  ESC CANCEL"; color: #39684a; font-size: 8px; horizontal-alignment: center; }
                }
            }

            aboutview := Rectangle {
                visible: view-state == 6;
                VerticalLayout {
                    padding: 5px;
                    spacing: 3px;
                    Text { text: "RATPUTER v0.2"; color: #7dffa9; font-size: 12px; horizontal-alignment: center; height: 18px; vertical-alignment: center; }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text {
                        text: "SLINT 1.18 + ESP-HAL 1.2\nNO_STD  XTENSA LX7\nST7789 240x135 @40MHZ\nTCA8418 + SD + WI-FI\nESP32-S3FN8  NO PSRAM";
                        color: #46a06a;
                        font-size: 8px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle { height: 1px; background: #0d2b16; }
                    Text { text: "BS/ENTER = MENU"; color: #39684a; font-size: 8px; horizontal-alignment: center; height: 12px; }
                }
            }
        }
    }

    // ============================================================
    // BUSY POPUP (over every main view while the radio works)
    // ============================================================
    busy-overlay := Rectangle {
        visible: root.splash-done && root.wifi-connecting;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #000000aa;

        Rectangle {
            x: (parent.width - 150px) / 2;
            y: (parent.height - 58px) / 2;
            width: 150px;
            height: 58px;
            background: #05130b;
            border-width: 1px;
            border-color: #2b5c3b;
            border-radius: 3px;

            VerticalLayout {
                padding: 6px;
                spacing: 3px;
                Text {
                    text: frame-index == 0 ? "|" : frame-index == 1 ? "/" : frame-index == 2 ? "-" : "+";
                    color: #7dffa9;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                Text {
                    text: wifi-status;
                    color: #46a06a;
                    font-size: 8px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    states [
        in-splash when !root.splash-done : {
            splash.opacity: 1;
            mainscreen.opacity: 0;
        }
        in-main when root.splash-done : {
            splash.opacity: 0;
            mainscreen.opacity: 1;
            in {
                animate splash.opacity { duration: 600ms; easing: ease-out; }
                animate mainscreen.opacity { duration: 600ms; easing: ease-out; }
            }
        }
    ]
}
